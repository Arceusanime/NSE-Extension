{
  "manifest_version": 3,
  "name": "NSE OI Auto S&R Overlay",
  "version": "1.1",
  "description": "Automatically calculates & overlays 3 Resistance and 3 Support levels on TradingView using real NSE Option Chain OI logic.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://*.nseindia.com/*",
    "https://*.nseindia.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
